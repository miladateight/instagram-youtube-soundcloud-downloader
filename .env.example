BOT_NAME=Atieght Downloader
BOT_TOKEN=123456789:replace-me
ADMIN_ID=123456789

# Optional. Admin Telegram username for the support button (without @).
# If set, the support button links to t.me/yourname. Otherwise it uses the admin ID.
SUPPORT_USERNAME=

# Optional. Bot username (without @) for the share button.
# If set, the share button links to t.me/your_bot.
BOT_USERNAME=

# Initial default only. The admin can later change public access inside Telegram:
# /public_on
# /public_off
ALLOW_ALL_USERS=false

# Forced channel subscription is managed inside Telegram by the admin:
# /forcejoin_on @your_channel
# /forcejoin_off

# 0 means the bot will not block files by size. Telegram Bot API can still reject
# files that are above the real upload limit of your Bot API mode.
MAX_UPLOAD_MB=0

# Protect the server from huge playlist/profile downloads.
PLAYLIST_LIMIT=20
CONCURRENT_DOWNLOADS=4

DOWNLOAD_DIR=downloads
DATA_DIR=data
LOG_DIR=logs

# Optional. Use a Netscape cookies.txt exported from your browser if Instagram
# or YouTube asks for login/age verification.
COOKIES_FILE=

# Feature toggles. Set to true/false to enable/disable each platform.
# These are set by the installer; you can also edit them here manually.
ENABLE_YOUTUBE=true
ENABLE_INSTAGRAM=true
ENABLE_SOUNDCLOUD=true

# Song detection (Shazam). Enabled by default. Uses the free shazamio library.
# Set to false to disable the "Find song" button entirely.
ENABLE_SONG_DETECTION=true

# Optional. If you want to use a custom Shazam API key instead of the free
# shazamio library, set it here. Leave empty to use the default free mode.
SHAZAM_API_KEY=

# Optional. Force IPv4 for downloads. Can help with YouTube HTTP 403 errors
# on some servers/VPNs. Leave false unless you encounter 403 errors.
FORCE_IPV4=false

# Optional. HTTP/HTTPS proxy for yt-dlp downloads (e.g. http://proxy:8080).
# Leave empty for direct connection.
HTTP_PROXY=
